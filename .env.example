# Copy to .env and fill in. Never commit .env.

# ---- Mode
SAMPLE_MODE=false            # true = run on local copies with recorded/offline responses, no credentials needed

# ---- Zetaris (data layer) - create the API key yourself in the Zetaris web UI
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
RIND_DATA_BASE_URL=https://raw.githubusercontent.com/YOUR_GITHUB_USER/rind/main/data/sources

# ---- Meterless Nightshift (AI provider) - copy URL + API key from Nightshift > Console
# The NVIDIA key goes in Nightshift > Setup > Providers, never here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_APP=rind
METERLESS_MODEL=meterless/auto
# Pin Nemotron-backed routes (see GET /v1/models) for the two lanes:
METERLESS_MODEL_FAST=your-nemotron-lightning-route
METERLESS_MODEL_DEEP=your-nemotron-super-route

# ---- Agent budgets
RIND_MAX_DEEP_DIVES=26
RIND_MAX_SKEPTIC_ROUNDS=2
RIND_CONCURRENCY=4
LLM_TIMEOUT_S=180
LLM_MIN_TOKENS=4096           # Nemotron reasons before answering; too small a budget = empty response (502)
LLM_PARALLEL=2                # max simultaneous model calls (free NVIDIA endpoints throttle bursts)
LLM_BACKOFF_S=4
NEMOTRON_THINKING_OFF=true    # ask Nemotron to skip hidden reasoning for structured JSON steps
RIND_MEMORY_BACKEND=hmem      # Meterless H-MEM engine (needs Node + `npm install` in hmem/); local = JSON baseline
RIND_RECORD_LLM=false         # true = save live responses for SAMPLE_MODE replay
